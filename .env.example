# Copy to .env.cli and pass --env-file .env.cli explicitly.
TEACH_API_BASE=https://api.openai.com/v1
TEACH_MODEL=your-model-name
TEACH_API_KEY=your-api-key
TEACH_DATA_DIR=data-v2
TEACH_REQUEST_TIMEOUT=90
TEACH_OPERATION_TIMEOUT=180
TEACH_OUTPUT_TOKENS=8000
# Conservative character budget for a single input, not a token count.
TEACH_INPUT_CHARS=48000
