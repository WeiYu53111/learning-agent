    "test:e2e": "playwright test",
    "format:check": "prettier --check src e2e/*.ts *.ts *.json index.html",
    "format": "prettier --write src e2e/*.ts *.ts *.json index.html"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.90.0",
    "@xyflow/react": "^12.9.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.9.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@testing-library/jest-dom": "^6.9.0",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "vite": "^7.1.0",
    "vitest": "^3.2.4"
  }
}
